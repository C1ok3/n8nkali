# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=n8nkali
POSTGRES_USER=n8nkali
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_PORT=5000
SCRAPER_SERVICE_URL=http://scraper:5000

# ── Ollama (your local Kali machine) ─────────────────────────────────────────
# From inside Docker containers, use host.docker.internal to reach host Ollama
# From Kali directly (no Docker), use localhost
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434   # use this if running n8n outside Docker

# ── AI fallback (Anthropic) ───────────────────────────────────────────────────
# Only needed if you want cloud fallback when Ollama is unavailable
ANTHROPIC_API_KEY=

# ── Assets ────────────────────────────────────────────────────────────────────
ASSETS_DIR=/app/assets
